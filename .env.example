# Copy to .env next to docker-compose.yml and fill in. Keep the file readable by the owner only: chmod 600 .env

# Domains pointing at the server's public IP (DNS A records), and the address for Let's Encrypt notices.
SITE_DOMAIN=trainer.example.com
ADMIN_DOMAIN=admin.trainer.example.com
ACME_EMAIL=

# Secrets: generate each with  openssl rand -hex 32
DB_PASSWORD=
APP_SECRET=
AUTH_SERVICE_KEY=
TRAINING_SERVICE_KEY=

ADMIN_LOGIN=
ADMIN_PASSWORD=

# Tokens from @BotFather. Use different bots than for local development.
AUTH_BOT_TOKEN=
BOT_TOKEN=

# Optional
# CERTBOT_STAGING=1    test certificates from the Let's Encrypt staging server, for a first trial run
# BOT_DEFAULT_TIME_ZONE=Europe/Moscow
# BACKUP_KEEP_DAYS=14
