# Port 80: Let's Encrypt challenges and a redirect to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN} ${ADMIN_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        # Until the first certificate is issued there is nothing to redirect to.
        if (!-f /certs/admin/fullchain.pem) {
            return 503 "The certificate is being issued. Try again in a minute.\n";
        }
        return 301 https://$host$request_uri;
    }
}

# Requests for any other name, including the bare IP address, get nothing.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
